{
  "name": "dsh-chief",
  "version": "0.3.0",
  "description": "SuperHub 是 DeepSeek Harness 的个人 AI 工作空间。通过一个接口人交办，按项目组织 AI 协作，按自己的节奏接回汇报。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "templates",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "third_party"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "pnpm check"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ical.js": "2.2.1",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "agents",
    "second-brain",
    "multi-agent"
  ],
  "bin": {
    "superhub": "./bin/cli.mjs",
    "dsh-chief": "./bin/cli.mjs"
  },
  "homepage": "https://codepothunter.github.io/SuperHub/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodePothunter/SuperHub.git"
  },
  "bugs": {
    "url": "https://github.com/CodePothunter/SuperHub/issues"
  }
}
